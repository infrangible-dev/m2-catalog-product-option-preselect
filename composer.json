{
    "name": "infrangible/m2-catalog-product-option-preselect",
    "description": "Lets you mark a value of a drop-down option that is already selected when the product page opens, so shoppers start with the most common choice.",
    "type": "magento2-module",
    "version": "1.1.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "preselected custom option value",
        "preselect drop-down option",
        "default selected option"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-option-preselect",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionPreselect\\": "src"
        }
    }
}
